{
  "name": "murmur",
  "private": true,
  "version": "0.1.0-pre.1",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "overrides": {
      "@tauri-apps/api": "2.10.1",
      "express-rate-limit>ip-address": "10.3.1"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-production-bundle.mjs",
    "test:unit": "vitest run",
    "test:release-metadata": "node --test scripts/release-metadata.test.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:release-metadata:release": "node scripts/check-release-metadata.mjs --release",
    "legal:inventory": "node scripts/generate-third-party-inventory.mjs",
    "legal:inventory:check": "node scripts/generate-third-party-inventory.mjs --check",
    "build:app-local": "tauri build --bundles app --no-sign && node scripts/check-macos-app-bundle.mjs",
    "check:macos-bundle": "node scripts/check-macos-app-bundle.mjs",
    "check:macos-signature-entitlements": "node scripts/check-macos-app-bundle.mjs --verify-app-entitlements",
    "build:dmg": "rm -rf src-tauri/target/release/bundle/dmg && tauri build --bundles dmg --no-sign && node scripts/check-macos-app-bundle.mjs --dmg src-tauri/target/release/bundle/dmg",
    "build:meeting-debug": "tauri build --debug --bundles app --features meeting-capture-debug --config src-tauri/tauri.debug.conf.json",
    "build:meeting-local": "tauri build --bundles app --config src-tauri/tauri.meeting-local.conf.json",
    "dev:meeting": "tauri dev --features meeting-capture-debug --config src-tauri/tauri.debug.conf.json",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/google-sans-flex": "5.3.1",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "3.2.6",
    "vue-tsc": "^2.1.10"
  }
}
