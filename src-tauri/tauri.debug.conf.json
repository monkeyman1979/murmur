{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur Debug",
  "identifier": "com.monkeyman.murmur.debug",
  "bundle": {
    "macOS": {
      "signingIdentity": "Murmur Dev"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "backgroundThrottling": "disabled",
        "title": "Murmur Debug",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "indicator",
        "url": "index.html?window=indicator",
        "title": "Murmur Debug Recording",
        "width": 360,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "closable": false,
        "focusable": true,
        "shadow": false
      },
      {
        "label": "indicator-notch",
        "url": "index.html?window=indicator&mirror=1",
        "title": "Murmur Dictation Status",
        "width": 329,
        "height": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "resizable": false,
        "closable": false,
        "visibleOnAllWorkspaces": true,
        "shadow": false
      },
      {
        "label": "meeting-controller",
        "url": "index.html?window=meeting-controller",
        "title": "Murmur Debug Meeting Recording",
        "width": 320,
        "height": 46,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "closable": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "shadow": false,
        "transparent": true
      },
      {
        "label": "meeting-notch",
        "url": "index.html?window=meeting-controller",
        "title": "Murmur Meeting Status",
        "width": 345,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false,
        "resizable": false,
        "closable": false,
        "visibleOnAllWorkspaces": true,
        "shadow": false
      },
      {
        "label": "meeting-reminder",
        "url": "index.html?window=meeting-reminder",
        "title": "Murmur Meeting Reminder",
        "width": 360,
        "height": 208,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "closable": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ]
  }
}
